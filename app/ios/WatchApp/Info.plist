<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Matches the iPhone app exactly. A companion that appears under a different
	     name in the Watch app's list reads as a separate product. -->
	<key>CFBundleDisplayName</key>
	<string>APRS Map</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Not $(PRODUCT_NAME): that is the Xcode target name, "WatchApp", which would
	     surface to users anywhere CFBundleName is preferred over the display name. -->
	<key>CFBundleName</key>
	<string>APRS Map</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Repeated from the iPhone app's Info.plist rather than inherited: App Store
	     Connect asks the export-compliance question of every binary in the bundle, and
	     an embedded watch app that stays silent parks the whole build at "Missing
	     Compliance", where it goes out to no testers at all — internal included.
	     False is the right answer for the same reason it is on the phone: HTTPS and
	     Keychain are exempt, and neither app carries encryption of its own. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Both come from pubspec.yaml via WatchApp.xcconfig -> Flutter/Generated.xcconfig,
	     so the watch app and the iPhone app always ship the same version. -->
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>WKApplication</key>
	<true/>
	<!-- Literal, not $(...): flutter_tools reads this file directly to detect a watch
	     companion (xcode_project.dart containsWatchCompanion). A variable here still
	     works but costs an extra `xcodebuild -showBuildSettings` on every build. -->
	<key>WKCompanionAppBundleIdentifier</key>
	<string>org.marsaprs.aprsMap</string>
	<!-- Push-to-talk records while the Talk button is held. No speech-recognition
	     string is needed here: watchOS has no recogniser to ask for. The clip goes to
	     the iPhone, which transcribes it and deletes it. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Hold the Talk button to speak a reply. The microphone is only on while you hold it, and the recording is deleted as soon as it has been turned into text.</string>
</dict>
</plist>
