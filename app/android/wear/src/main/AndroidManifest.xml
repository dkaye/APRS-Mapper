<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The haptic. The one signal that survives Silent Mode, a wrist turned away and
         no audio route at all; see Announcer.kt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Push-to-talk. Unlike watchOS, Wear OS has a speech recogniser of its own, so the
         microphone is used here rather than shipping audio to the phone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+: the alert raised when a message arrives while this app is not on
         screen and therefore cannot speak. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ambient mode, so the app stays resident with the screen dimmed rather than being
         replaced by the watch face. That is the state an operator wears through a net. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".WearApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- Not standalone. The watch can poll the server by itself when the phone is
             away, but only with a token the phone gave it, and only for an event the
             phone joined. A watch installed on its own would have nothing to show. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- How a message reaches a watch whose app is not running.
             The Data Layer starts this service to deliver a DataItem or a message even
             when nothing of ours is on screen, which is the Wear equivalent of
             WatchConnectivity waking a watchOS app for a queued transferUserInfo. It is
             what lets an arriving message raise a notification rather than being noticed
             an hour later. -->
        <service
            android:name=".PhoneListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/aprs"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

    <!-- Android 11+ package visibility: without this, SpeechRecognizer.isRecognitionAvailable
         reports false on a watch that has a perfectly good recogniser installed, and
         push-to-talk silently falls back to nothing. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
