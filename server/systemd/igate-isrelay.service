# igate-isrelay — APRS-IS aggregation relay for the K6DRK iGate fleet
#
# Install: sudo cp igate-isrelay.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now igate-isrelay
#
# Our controlled iGates (via their local isproxy) connect here instead of the
# public APRS-IS; the relay records their undeduped RF->IS stream and forwards
# it upstream. See /var/www/html/bin/igate-isrelay.py.

[Unit]
Description=iGate APRS-IS aggregation relay
Documentation=file:///var/www/html/README.MD
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=10

[Service]
Type=simple
User=pi
Group=pi
# IPv6 wildcard: the relay makes this a dual-stack socket (see igate-isrelay.py),
# so remote iGates reach us over IPv6 (no NAT) and LAN iGates over IPv4.
Environment=ISRELAY_HOST=::
Environment=ISRELAY_PORT=14590
Environment=ISRELAY_UP_HOST=noam.aprs2.net
Environment=ISRELAY_UP_PORT=14580
Environment=ISRELAY_SIGNAL=/var/www/html/igate_relay.json
Environment=ISRELAY_CAPTURE=/home/pi/igate-isrelay/capture.jsonl
# ISRELAY_ALLOW empty = accept any callsign; tighten to our fleet once stable.
Environment=ISRELAY_ALLOW=
ExecStart=/usr/bin/python3 /var/www/html/bin/igate-isrelay.py
Restart=on-failure
RestartSec=10
UMask=0022

[Install]
WantedBy=multi-user.target
