[Unit]
Description=Transcriber channel %i
# The channel needs the network to post entries, but must not refuse to start
# without it: entries queue on disk, so a Pi that boots before its WiFi comes up
# should listen anyway rather than sit dead until someone restarts it.
Wants=network-online.target
After=network-online.target
# No start rate limit, for the same reason as the iGate's direwolf: an unattended
# receiver should keep retrying forever rather than give up quietly mid-event.
# Must be in [Unit] — systemd ignores it under [Service].
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
ExecStart=/opt/transcriber/bin/transcriber.py --channel %i
Restart=always
RestartSec=10
# /run/transcriber/%i on tmpfs, for the audio clips — see clip_dir(). systemd creates it
# owned by User= and empties it when the unit stops, so clips cannot outlive the process
# that recorded them the way they used to after a kill. The outbox stays on the card
# under /var/spool/transcriber: it exists to survive a reboot.
RuntimeDirectory=transcriber/%i
RuntimeDirectoryMode=0750
# ExecStart spawns arecord and sox, so stopping must take down the whole cgroup or they
# would be left holding the capture device and the next start would fail to open it:
# only one process at a time may have the sound card, and it says so as "Device or
# resource busy".
KillMode=control-group
# Below the iGate's Nice=-5: decoding APRS packets is real-time and must not be
# starved, while a transcription arriving a second later costs nothing. On a Pi
# doing both, packets win.
Nice=5

[Install]
WantedBy=multi-user.target
